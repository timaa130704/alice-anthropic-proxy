# ---- сервер ----
HOST=127.0.0.1
PORT=8787
# если раскомментировать — клиент обязан присылать x-api-key / Bearer
# PROXY_API_KEY=local

# ---- авторизация в Алисе ----
# пусто = анонимный режим (без истории и с лимитами)
# ALICE_COOKIE=Session_id=...; sessionid2=...; yandexuid=...; i=...; yandex_login=...
ALICE_UUID=
ALICE_DEVICE_ID=

# ---- модель ----
# Base — бесплатный, Pro — подписка/триал (5 запросов у анонима)
ALICE_MODE=Base
# пусто или preset из настроек модели
ALICE_MODE_PRESET=
DEFAULT_MODEL=alice-ai

# ---- поведение ----
REQUEST_TIMEOUT_MS=180000
# true = просить модель вернуть <tool_use>{...}</tool_use> и превращать в tool_use блок
TOOL_EMULATION=true
# инструменты, которые не показываем модели (слабые модели зовут их не к месту)
TOOL_DENY=Agent,Task,Workflow,ExitPlanMode,AskUserQuestion,TodoWrite,WebSearch,WebFetch,NotebookEdit,ListAgents,SendMessage,ReportFindings,ScheduleWakeup,Skill,ToolSearch,DeferredToolPlaceholder
# бюджет промпта: Claude Code присылает ~85k символов, Алиса столько не переваривает
MAX_PROMPT_CHARS=16000
# 0 = вообще не передавать системный промпт клиента (иногда только мешает)
MAX_SYSTEM_CHARS=6000
# true = продолжать один и тот же диалог на сервере (история живёт у Алисы),
# false = каждый запрос независим, история приходит из messages (как у Anthropic)
KEEP_DIALOG=false
VERBOSE=false

# ---- телеграм-бот ----
# токен от @BotFather
BOT_TOKEN=
BOT_PROXY_URL=http://127.0.0.1:8787
# слово, после которого бот отвечает (в группах нужен privacy mode off)
BOT_TRIGGER=пидорас
# сколько пар реплик помнить в каждом чате
BOT_HISTORY=8
BOT_MODEL=alice-ai
# чаты, где бот отвечает на любое сообщение, а не только по триггеру
# можно -1004423734015 или 4423734015, несколько через запятую
BOT_ALL_CHATS=

# ---- юзербот (telethon, отвечает в лс от твоего аккаунта) ----
# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# номер в международном формате, чтобы не вводить каждый запуск (необязательно)
TG_PHONE=
# mtproto-прокси для телеграма: tg://proxy?server=...&port=...&secret=...
# или host:port:secret. пусто = подключаться напрямую
TG_PROXY=
# прокси, история, минимальный интервал между ответами одному человеку
UB_PROXY_URL=http://127.0.0.1:8787
UB_HISTORY=6
UB_RATE=2
# через запятую: id или @username, кому отвечать. пусто = всем
UB_ALLOW=
# системный промпт юзербота. пусто = чистая алиса без инструкций
UB_SYSTEM=
